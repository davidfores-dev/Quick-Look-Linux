#!/usr/bin/env bash
set -Eeuo pipefail
echo "============================================================"
echo " QUICKLOOK LINUX R8.9 — FINAL + COMPATIBLE CON INSTALAR"
echo "============================================================"
TMP="$(mktemp -d /tmp/quicklook-r89.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT
cat > "$TMP/source.zip.b64" <<'PAYLOAD'

PAYLOAD
base64 -d "$TMP/source.zip.b64" > "$TMP/source.zip"
unzip -q "$TMP/source.zip" -d "$TMP/source"
chmod +x "$TMP/source/install-final.sh" \
         "$TMP/source/quicklook-launch" \
         "$TMP/source/quicklook-desktop-launcher.sh" \
         "$TMP/source/quicklook-url-handler" \
         "$TMP/source/quicklook-repair-dolphin" \
         "$TMP/source/quicklook-repair-desktop" \
         "$TMP/source/repair-folderview-root"
exec bash "$TMP/source/install-final.sh"
